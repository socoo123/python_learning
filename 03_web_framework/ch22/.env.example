# Ch22 · .env.example —— 环境变量模板(对应 tutorial.md §22.3)
#
# 用法:cp .env.example .env,然后按环境填真实值。
# Settings(BaseSettings) 启动时自动读 .env;环境变量优先级高于 .env。
# ⚠️ .env 绝不提交 git(.gitignore 应忽略它);仓库里只放这个 example。

# 应用名
APP_NAME=order-service

# 运行环境:dev / staging / prod
ENVIRONMENT=dev

# 调试模式:生产必须 false(字符串,Settings 自动转 bool)
DEBUG=true

# 数据库连接串:生产换成 postgresql://user:pass@host:5432/orders
DATABASE_URL=sqlite:///./app.db

# JWT/会话密钥:生产必须换成长随机串(≥16 位,如 openssl rand -hex 32)
SECRET_KEY=dev-secret-change-me

# token 有效期(分钟,自动转 int)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis 连接串(可选,不设就是 None)
# REDIS_URL=redis://localhost:6379/0
