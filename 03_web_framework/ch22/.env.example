# Ch22 · 配置文件示例(复制为 .env 后改值)
# 对应 tutorial.md §22.3。pydantic-settings 会自动读 .env(优先级 < 真环境变量)。

APP_NAME=Product API
ENVIRONMENT=dev
DEBUG=true

# 数据库(生产换 postgresql://...)
DATABASE_URL=sqlite:///./app.db

# JWT 密钥(生产用 openssl rand -hex 32 生成)
SECRET_KEY=dev-secret-change-me

# token 有效期(分钟)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 可选:Redis
# REDIS_URL=redis://localhost:6379/0
