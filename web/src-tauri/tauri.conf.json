{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PythonLearning",
  "version": "0.3.0",
  "identifier": "com.zy.pythonlearning",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5188",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Python 学习",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#e9e2d4"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
